{
  "expo": {
    "name": "Тихая практика",
    "slug": "quiet-practice",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/quiet-practice-icon.png",
    "scheme": "quietpractice",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/quiet-practice-icon.png",
      "bundleIdentifier": "ai.mypraxis.quietpractice",
      "buildNumber": "6",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3EFE5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3EFE5",
          "image": "./assets/images/quiet-practice-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
