# Only public, non-secret client configuration belongs here.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
# Separate schedule-only API. Production builds need a reachable HTTPS address.
EXPO_PUBLIC_SCHEDULE_API_URL=http://127.0.0.1:8001
# Legacy wiki endpoint retained only for historical tooling; Daychee uses the API below.
# Never put login/password in EXPO_PUBLIC_*.
EXPO_PUBLIC_WIKI_API_URL=http://127.0.0.1:8766

# Next-version personal-access API; HTTPS only. No fallback to the legacy wiki.
EXPO_PUBLIC_DAYCHEE_API_URL=

# Opt-in read-only Cabinet schedule; ordinary School source remains available.
# Origin excludes /api. Use staging for the current TestFlight pilot.
EXPO_PUBLIC_CABINET_SCHEDULE_PILOT=0
EXPO_PUBLIC_CABINET_API_ORIGIN=https://staging.xuanxue.su

# Explicit opt-in for the native Cabinet account, including Release candidates.
EXPO_PUBLIC_CABINET_ACCOUNT_ENABLED=0
# Development-only pilot retained for local QA.
EXPO_PUBLIC_CABINET_ACCOUNT_PILOT=0
EXPO_PUBLIC_CABINET_ACCOUNT_ORIGIN=https://staging.xuanxue.su

# Preparation only: explicit native content transport, not mounted in the public reader.
# Requires matching Cabinet account/backend profiles and separate activation/UX QA.
EXPO_PUBLIC_CABINET_CONTENT_ENABLED=0
