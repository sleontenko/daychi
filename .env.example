# Primary provider: named AWS profile, without copying access keys.
PRACTICE_AWS_PROFILE=default
AWS_REGION=us-east-1
BEDROCK_MODEL=us.anthropic.claude-sonnet-4-6

# Optional secondary provider. Never expose this through EXPO_PUBLIC_* variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

PRACTICE_INGEST_DB=data/ingest.db
PRACTICE_NOTEBOOK_PLAN=data/notebook_plan.json
PRACTICE_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
